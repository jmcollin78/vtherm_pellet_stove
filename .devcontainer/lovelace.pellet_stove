{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.pellet_stove",
  "data": {
    "config": {
      "views": [
        {
          "type": "sections",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Nouvelle section"
                },
                {
                  "type": "tile",
                  "grid_options": {
                    "columns": "full"
                  },
                  "entity": "sensor.rad_simulator_room_temperature",
                  "state_content": [
                    "state",
                    "last_changed"
                  ],
                  "vertical": false,
                  "features": [
                    {
                      "type": "trend-graph"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "grid_options": {
                    "columns": "full"
                  },
                  "entity": "sensor.rad_simulator_external_temperature",
                  "state_content": [
                    "state",
                    "last_changed"
                  ],
                  "vertical": false,
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "grid_options": {
                    "columns": "full"
                  },
                  "entity": "input_number.fake_outdoor_temperature",
                  "state_content": [
                    "state",
                    "last_changed"
                  ],
                  "vertical": false,
                  "features_position": "bottom",
                  "features": [
                    {
                      "type": "numeric-input",
                      "style": "buttons"
                    }
                  ]
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "VTherm",
                  "heading_style": "title",
                  "icon": "mdi:gas-burner"
                },
                {
                  "type": "custom:versatile-thermostat-ui-card",
                  "entity": "climate.vtherm_pellet",
                  "name": "VTherm Pellet",
                  "theme": "vtherm",
                  "set_current_as_main": true,
                  "allow_lock_toggle": false,
                  "show_regulation_chart": true,
                  "allow_preset_modification": true
                },
                {
                  "type": "history-graph",
                  "entities": [
                    {
                      "entity": "climate.vtherm_pellet"
                    },
                    {
                      "entity": "binary_sensor.poele_actif"
                    }
                  ],
                  "hours_to_show": 4
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading_style": "title",
                  "heading": "Underlying",
                  "icon": "mdi:home-thermometer-outline"
                },
                {
                  "type": "tile",
                  "entity": "switch.rad_simulator_heater_switch_pwm",
