                  }
                },
                {
                  "type": "history-graph",
                  "entities": [
                    {
                      "entity": "switch.rad_simulator_heater_switch_pwm"
                    }
                  ],
                  "hours_to_show": 1
                },
                {
                  "type": "entity",
                  "entity": "sensor.pellet_stove_vtherm_pellet_debogage_regulation_pellet",
