// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "name": "Versatile Thermostat Poêle à Pellets",
    "appPort": ["8123:8123"],
    "postCreateCommand": "bash .devcontainer/bootstrap-python.sh",
    "postStartCommand": "bash .devcontainer/bootstrap-python.sh",
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
        // the VTherm integration
        "source=/Users/jmcollin/SugarSync/Projets/home-assistant/versatile_thermostat/custom_components/versatile_thermostat,target=/workspaces/vtherm_pellet_stove/custom_components/versatile_thermostat,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.pylint",
                "ms-python.isort",
                "ms-python.black-formatter",
                "redhat.vscode-yaml",
                "github.vscode-pull-request-github",
                "ryanluker.vscode-coverage-gutters",
                "ferrierbenjamin.fold-unfold-all-icone",
                "donjayamanne.githistory",
                "waderyan.gitblame",
                "keesschollaart.vscode-home-assistant",
                "vscode.markdown-math",
                "yzhang.markdown-all-in-one",
                "github.vscode-github-actions",
                "azuretools.vscode-docker",
                "huizhou.githd",
                "github.copilot",
                "bierner.markdown-mermaid"
            ],
            "settings": {
                "files.eol": "\n",
                "editor.tabSize": 4,
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "bash",
                        "args": []
                    }
                },
                "terminal.integrated.defaultProfile.linux": "bash",
                "python.pythonPath": "/workspaces/vtherm_pellet_stove/.venv/bin/python",
                "python.defaultInterpreterPath": "/workspaces/vtherm_pellet_stove/.venv/bin/python",
                "python.analysis.autoSearchPaths": true,
                "pylint.lintOnChange": false,
                "python.formatting.provider": "black",
                "python.formatting.blackArgs": ["--line-length", "180"],
                "python.formatting.blackPath": "/usr/local/py-utils/bin/black",
                "editor.formatOnPaste": false,
                "editor.formatOnSave": true,
                "editor.formatOnType": true,
                "files.trimTrailingWhitespace": true
            }
        }
    }
}
