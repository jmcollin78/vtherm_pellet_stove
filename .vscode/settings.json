{
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "modifications"
    },
    "files.associations": {
        "*.yaml": "home-assistant"
    },
    "python.testing.pytestArgs": ["-vv"],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.analysis.extraPaths": [
        "/workspaces/vtherm_pellet_stove/custom_components/vtherm_pellet_stove",
        "/home/vscode/.local/lib/python3.13/site-packages/homeassistant"
    ],
    "python.defaultInterpreterPath": "/workspaces/vtherm_pellet_stove/.venv/bin/python",
    "python-envs.defaultEnvManager": "ms-python.python:venv"
}
